  registrationStart               DateTime?
  registrationEnd                 DateTime?
  lateRegistrationStart           DateTime?
  lateRegistrationEnd             DateTime?
  pricingEarlyStudent             Int                  @default(30)
  pricingEarlyAdult               Int                  @default(55)
  pricingRegularStudent           Int                  @default(30)
  pricingRegularAdult             Int                  @default(55)
  pricingLateStudent              Int                  @default(55)
  pricingLateAdult                Int                  @default(55)
  finalsTournamentStartDate       DateTime?
  finalsTournamentEndDate         DateTime?
  finalsTournamentDescription     String               @default("")
  finalsTournamentLocation        Location?            @relation("League_finalsTournamentLocation", fields: [finalsTournamentLocationId], references: [id])
  finalsTournamentLocationId      String?              @map("finalsTournamentLocation")
  jerseyDesign_filesize           Int?
  jerseyDesign_filename           String?
  registrationShareImage_filesize Int?
  registrationShareImage_filename String?
  requestAttendance               Boolean              @default(false)
  requestShirtSize                Boolean              @default(false)

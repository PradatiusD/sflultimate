datasource sqlite {
  url               = env("DATABASE_URL")
  shadowDatabaseUrl = env("SHADOW_DATABASE_URL")
  provider          = "sqlite"
}

generator client {
  provider = "prisma-client-js"
}

model BoardMember {
  id                          String          @id @default(cuid())
  firstName                   String          @default("")
  lastName                    String          @default("")
  order                       Int
  active                      Boolean         @default(false)
  description                 String          @default("")
  image_filesize              Int?
  image_filename              String?
  from_BoardPosition_assigned BoardPosition[] @relation("BoardPosition_assigned")
}

model BoardPosition {
  id          String        @id @default(cuid())
  title       String        @default("")
  order       Int
  active      Boolean       @default(false)
  description String        @default("")
  commitment  String        @default("")
  assigned    BoardMember[] @relation("BoardPosition_assigned")
}

model ClubTeam {
  id                  String  @id @default(cuid())
  name                String  @default("")
  category            String?
  order               Int

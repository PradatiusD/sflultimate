model Game {
  id                         String           @id @default(cuid())
  name                       String           @default("")
  league                     League?          @relation("Game_league", fields: [leagueId], references: [id])
  leagueId                   String?          @map("league")
  scheduledTime              DateTime?
  homeTeam                   Team?            @relation("Game_homeTeam", fields: [homeTeamId], references: [id])
  homeTeamId                 String?          @map("homeTeam")
  awayTeam                   Team?            @relation("Game_awayTeam", fields: [awayTeamId], references: [id])
  awayTeamId                 String?          @map("awayTeam")
  homeTeamScore              Int?
  homeTeamForfeit            Boolean          @default(false)
  awayTeamScore              Int?
  awayTeamForfeit            Boolean          @default(false)
  location                   Location?        @relation("Game_location", fields: [locationId], references: [id])
  locationId                 String?          @map("location")
  showNameOnSchedule         Boolean          @default(false)
  homeTeamStatSheet_filesize Int?
  homeTeamStatSheet_filename String?
  awayTeamStatSheet_filesize Int?
  awayTeamStatSheet_filename String?
  from_PlayerGameStat_game   PlayerGameStat[] @relation("PlayerGameStat_game")

  @@index([leagueId])
  @@index([homeTeamId])
  @@index([awayTeamId])
  @@index([locationId])
}

model League {
  id                              String               @id @default(cuid())
  name                            String               @default("")

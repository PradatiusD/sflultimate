  champion                        Team?                @relation("League_champion", fields: [championId], references: [id])
  championId                      String?              @map("champion")
  from_Game_league                Game[]               @relation("Game_league")
  from_Player_leagues             Player[]             @relation("Player_leagues")
  from_PlayerSubstitution_league  PlayerSubstitution[] @relation("PlayerSubstitution_league")
  from_Team_league                Team[]               @relation("Team_league")

  @@index([title])
  @@index([slug])
  @@index([finalsTournamentLocationId])
  @@index([championId])
}

model Location {
  id                                   String   @id @default(cuid())
  name                                 String   @default("")
  slug                                 String   @default("")
  mapsLocationUrl                      String   @default("")
  type                                 String

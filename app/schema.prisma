  websiteUrl          String  @default("")
  twitterPageUrl      String  @default("")
  interestFormPageUrl String  @default("")
}

model Event {
  id                 String   @id @default(cuid())
  name               String   @default("")
  slug               String   @default("")
  category           String   @default("")
  startTime          DateTime
  endTime            DateTime
  location           String   @default("")
  summary            String   @default("")
  description        String   @default("")
